generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model TestRun {
  id        String   @id @default(uuid())
  url       String
  method    String   @default("GET")
  body      String?
  targetRps Int
  duration  Int
  createdAt DateTime @default(now())

  // CONSTANT (constant load) | STEPPED (stepped increase)
  loadProfile String @default("CONSTANT")
  // Only set for STEPPED tests
  stepCount   Int?

  // RUNNING | COMPLETED | STOPPED | FAILED | INTERRUPTED
  status     String    @default("RUNNING")
  finishedAt DateTime?

  // Computed and written once when the test ends. The history list reads only these.
  totalRequests    Int?
  avgResponseTime  Float?
  minResponseTime  Int?
  maxResponseTime  Int?
  p95              Int?
  p99              Int?
  stdDev           Float?
  serverErrorCount Int?
  totalBytes       BigInt?
  actualDurationMs Int?
  // Highest Volta lag during the test (excluding the first second).
  // If it exceeded the warning limit, the analysis says "Volta was under strain during this test, results may be unreliable".
  maxLagMs         Int?

  // The test's actual start time: the worker reports it right before starting the scheduler.
  // Analysis, summary and chart seconds are counted from here (not from the first response).
  // Empty for tests made before this field was added; those count from the first response.
  startedAt DateTime?

  results TestResult[]
}

model TestResult {
  id        Int      @id @default(autoincrement())
  testRunId String
  timestamp DateTime @default(now())

  // 0 if no response arrived
  statusCode Int

  // If no response arrived: TIMEOUT | CONNECTION_REFUSED | CONNECTION_RESET | NETWORK_ERROR
  errorType String?

  responseTime Int

  // Size downloaded over the network (bytes)
  responseSize Int @default(0)

  testRun TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@index([testRunId])
}

// Saved targets (target book). Clearing the database doesn't touch this table.
model SavedTarget {
  id        Int      @id @default(autoincrement())
  name      String
  // Lowercased name: so "Test Sunucusu" and "test sunucusu" count as the same
  nameKey   String   @unique
  url       String   @unique
  createdAt DateTime @default(now())
}
