# Volta's settings. During `npm install` this file is copied to ".env" (if .env doesn't exist yet).
# Everything here is optional: without .env, Volta uses the values below.

# Database file (relative to the project folder)
DATABASE_URL="file:./prisma/dev.db"

# Volta's port (default 4400; 80 isn't allowed)
# VOLTA_PORT=4400