{
  "name": "voltaload",
  "version": "1.0.0",
  "private": true,
  "description": "Visual load testing for localhost: live charts and an automatic analysis that explains the results in plain language.",
  "keywords": [
    "load-testing",
    "performance",
    "benchmark",
    "stress-test",
    "localhost",
    "http",
    "api"
  ],
  "homepage": "https://github.com/ard-daskiran/voltaload#readme",
  "bugs": {
    "url": "https://github.com/ard-daskiran/voltaload/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ard-daskiran/voltaload.git"
  },
  "license": "MIT",
  "author": "Arda Daşkıran (https://github.com/ard-daskiran)",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "prestart": "node scripts/setup.mjs --start",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "undici": "^8.11.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}